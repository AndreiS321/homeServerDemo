services:
  nginx:
    image: nginx:{{ nginx_version }}
    container_name: nginx
    ports:
      - 80:80
      - 443:443
      - 1080:1080
    volumes:
      - {{ nginx_config_path }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ nginx_config_path }}/conf.d:/etc/nginx/conf.d:ro
      - {{ nginx_config_path }}/snippets:/etc/nginx/snippets:ro
      - {{ nginx_config_path }}/logs:/var/log/nginx
      - {{ certbot_config_path }}/certs:/etc/letsencrypt
    networks:
      - {{ default_bridge_network_name }}
    restart: always
    
networks:
  {{ default_bridge_network_name }}:
    name: {{ default_bridge_network_name }}
    external: true